# Local development environment

cp .env.example .env

# ===== App =====
ENV=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# ===== API / Auth =====
# Generate a strong random value: openssl rand -hex 32
SECRET_KEY=change-me-in-production
JWT_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/local
JWT_AUDIENCE=local-client
COGNITO_USER_POOL_ID=ap-south-1_LOCAL
COGNITO_CLIENT_ID=local-client-id

# ===== LocalStack (AWS emulation) =====
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DATA_BUCKET=dhuan-data-lake
S3_PHOTO_BUCKET=dhuan-photos-private
DYNAMODB_EVENTUALLY_CONSISTENT=true
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:dhuan-alerts
SQS_DLQ_URL=http://localstack:4566/000000000000/dhuan-dlq

# ===== OpenSearch =====
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_SOURCES=pollution_sources
OPENSEARCH_INDEX_TRACES=agent_traces

# ===== Amazon Location =====
LOCATION_API_KEY=local-placeholder
LOCATION_MAP_NAME=DhuanMap
LOCATION_PLACE_INDEX_NAME=DhuanPlaces

# ===== PostGIS (source staging) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dhuan
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# ===== Redis =====
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# ===== External data feeds =====
OPENAQ_API_KEY=
OPEN_METEO_BASE=https://air-quality-api.open-meteo.com/v1
FIRMS_MAP_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_API_TIMEOUT_SECONDS=8
CIRCUIT_BREAKER_THRESHOLD=3

# ===== ML model =====
MODEL_ARTIFACT_S3_KEY=models/pm25_xgb/latest.tar.gz
MODEL_CONFIDENCE_QUANTILES=0.1,0.5,0.9

# ===== Strands / Bedrock (production only) =====
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
STRANDS_MAX_STEPS=8

# Rule: NEVER put real secrets in .env.example. Use .env locally only.
